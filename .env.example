# Copy to .env and adjust if needed. Defaults work for local team setup.

RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

MSSQL_SA_PASSWORD=Your_password123

AUTHENTIK_SECRET_KEY=change-me-dev-only-not-for-prod-use-32chars
AUTHENTIK_BOOTSTRAP_EMAIL=admin@gamerscommunity.local
AUTHENTIK_BOOTSTRAP_PASSWORD=admin
AUTHENTIK_HOST=http://localhost:9000
AUTHENTIK_PG_DB=authentik
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_PASSWORD=authentik

# OIDC client provisioned by blueprint (public SPA)
GC_OIDC_CLIENT_ID=gc-front

# Optional — Google social login/signup (Authentik source slug: google)
# Create OAuth client in Google Cloud; redirect URI:
#   http://localhost:9000/source/oauth/callback/google/
# AUTHENTIK_GOOGLE_CLIENT_ID=
# AUTHENTIK_GOOGLE_CLIENT_SECRET=
